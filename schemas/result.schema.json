{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Flight Test Result",
  "type": "object",
  "required": ["suite_version", "test_id", "status", "started_at", "ended_at", "prompt", "response", "tool_trace", "evidence"],
  "properties": {
    "suite_version": {"type": "string"},
    "test_id": {"enum": ["FT-01", "FT-02", "FT-03", "FT-04", "FT-05", "FT-06"]},
    "status": {"enum": ["pass", "partial", "fail", "not_tested"]},
    "failure_class": {"type": ["string", "null"]},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "latency_ms": {"type": ["number", "null"]},
    "ttft_ms": {"type": ["number", "null"]},
    "tokens_per_second": {"type": ["number", "null"]},
    "prompt": {"type": "string"},
    "response": {"type": "string"},
    "tool_trace": {"type": "array"},
    "evidence": {"type": "string"},
    "model_returned": {"type": ["string", "null"]},
    "substitution": {"type": ["boolean", "null"]}
  }
}
